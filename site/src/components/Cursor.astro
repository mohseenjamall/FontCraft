---
// The mouse pointer is a serif "f", the app's own letter. Only for a real mouse; touch and
// keyboard users, and anyone without JS, keep the normal pointer.
---

<div class="cursor-f" aria-hidden="true"><span>f</span></div>

<script>
  const mouse = window.matchMedia('(hover: hover) and (pointer: fine)');
  const cursor = document.querySelector<HTMLElement>('.cursor-f');

  if (cursor && mouse.matches) {
    const root = document.documentElement;
    const interactive = 'a, button, [role="scrollbar"], summary, label';

    root.classList.add('has-f-cursor');

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        cursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
        cursor.classList.add('is-visible');
        cursor.classList.toggle('is-link', Boolean((e.target as Element | null)?.closest?.(interactive)));
      },
      { passive: true },
    );

    document.addEventListener('mouseleave', () => cursor.classList.remove('is-visible'));
    window.addEventListener('pointerdown', () => cursor.classList.add('is-down'));
    window.addEventListener('pointerup', () => cursor.classList.remove('is-down'));
  }
</script>

<style is:global>
  html.has-f-cursor,
  html.has-f-cursor * {
    cursor: none !important;
  }

  /* One clean glyph, no outline: it inverts against whatever is under it, so it stays legible on
     cobalt, black and the light font list. The top-left of the letter is the click point. */
  .cursor-f {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 0;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    font-variation-settings: 'opsz' 72, 'SOFT' 0, 'WONK' 0;
    color: #fff;
    mix-blend-mode: difference;
    will-change: transform;
  }

  .cursor-f span {
    display: block;
    transform-origin: 0 0;
    transition: transform 0.16s cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  .cursor-f.is-visible {
    opacity: 1;
    transition: opacity 0.15s ease;
  }

  .cursor-f.is-link span {
    transform: scale(1.3);
  }

  .cursor-f.is-down span {
    transform: scale(0.88);
  }
</style>
